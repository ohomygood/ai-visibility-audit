# Production template — copy to production.env once budget/domain/Stripe are approved.
# AIV_ENV=production makes the app REFUSE the stub engine; there is no default engine list.
AIV_ENV=production
AIV_ENGINES=__REAL_ENGINES__            # e.g. openai,perplexity,gemini  (needs approved API budget)
OPENAI_API_KEY=__PENDING_APPROVAL__
PERPLEXITY_API_KEY=__PENDING_APPROVAL__
GEMINI_API_KEY=__PENDING_APPROVAL__
AIV_SITE_URL=https://__AIV_DOMAIN__
# Stripe (see docs/stripe_setup.md). Without STRIPE_RESTRICTED_KEY + AIV_STRIPE_PAYMENT_LINK_ID nothing unlocks.
AIV_STRIPE_PAYMENT_LINK=https://buy.stripe.com/fZu00k2l84Zz9YibSt0Ny02
AIV_STRIPE_PAYMENT_LINK_ID=plink___FROM_DASHBOARD__
AIV_STRIPE_EXPECTED_AMOUNT=1900
AIV_STRIPE_EXPECTED_CURRENCY=usd
STRIPE_RESTRICTED_KEY=rk_live___PENDING__        # read-only: Checkout Sessions: Read
STRIPE_WEBHOOK_SECRET=                            # optional backup route, whsec_...
AIV_DEV_UNLOCK=0
AIV_FREE_PER_HOUR=3
AIV_RETENTION_DAYS=7

# Manual unlock (docs/manual_unlock.md). openssl rand -hex 32; set as a Render secret, never commit.
ADMIN_TOKEN=
AIV_TRUST_PROXY=1                 # behind Render/Cloudflare only
# WeChat Pay (manual, no API)
AIV_WECHAT_ENABLED=1
AIV_WECHAT_PRICE_CNY=129
AIV_WECHAT_EARLYBIRD=0
AIV_WECHAT_EARLYBIRD_PRICE_CNY=99
AIV_WECHAT_QR_URL=/wechat_pay_qr.jpg
AIV_WECHAT_CONTACT=go_with_prob@mail.grokbot.com
