# Local development. Stub (simulated) engine is the default ONLY here.
AIV_ENV=dev
AIV_ENGINES=stub
AIV_DEV_UNLOCK=1
AIV_FREE_PER_HOUR=3
# This box resolves public hosts to a fake-IP proxy range (198.18.0.0/15); treat it as public for the SSRF guard.
# Do NOT set this in production.
# AIV_TRUSTED_NETS=  (only for a dev box whose DNS returns fake-IP ranges, e.g. 198.18.0.0/15; NEVER in production)
